# --- Required ---
DATABASE_URL=postgres://postgres@localhost:5432/keepsake
# Public URL of the site, used in every link we send.
APP_URL=http://localhost:3000
# 32+ random characters: `openssl rand -base64 48`
APP_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts letters. Never change it once letters exist.
ENCRYPTION_KEY=
# Protects /api/cron/tick. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Email (Resend) ---
# "console" prints messages to the server log instead of sending them.
EMAIL_PROVIDER=console
EMAIL_FROM="Keepsake <letters@yourdomain.in>"
RESEND_API_KEY=

# --- SMS and WhatsApp ---
# console | twilio | none
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number or a Messaging Service SID (needed for Indian DLT routes).
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp templates (Twilio Content SIDs, HX...). See README.
TWILIO_WA_TEMPLATE_REMINDER=
TWILIO_WA_TEMPLATE_RELEASE=

# --- Payments (Dodo Payments) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# The one-time ₹20 "20 more people" product.
DODO_PRODUCT_ID=
